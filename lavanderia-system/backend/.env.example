# ---- Servidor ----
PORT=3001
HOST=0.0.0.0
NODE_ENV=production

# Em produção o próprio servidor entrega o frontend compilado na porta acima.
SERVE_STATIC=true

# ---- Banco de dados (SQLite embutido, não precisa instalar nada) ----
# Caminho relativo à pasta "backend" (ou um caminho absoluto).
DB_PATH=data/lavanderia.db

# Popula o catálogo básico de serviços na primeira execução.
# Defina como false para começar com o catálogo vazio.
SEED_SERVICES=true

# ---- Primeiro acesso (usuário administrador) ----
# Usados apenas na criação inicial do banco. Troque a senha depois!
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@lavanderia.com
ADMIN_PASSWORD=admin123

# ---- Conta de administrador fixa (garantida em toda inicializacao) ----
OWNER_NAME=Jorge Suzuki
OWNER_EMAIL=jorge@lavanderia.com
OWNER_PASSWORD=0225

# ---- Loja (cabeçalho da notinha) ----
STORE_NAME=Lavanderia System
STORE_PHONE=
STORE_ADDRESS=
STORE_DOCUMENT=

# ---- Segurança (JWT) ----
# TROQUE por uma sequência aleatória longa em produção.
JWT_SECRET=lavanderia-secret-key-2024-super-secure
JWT_EXPIRES_IN=7d

# ---- CORS (usado no modo desenvolvimento com Vite) ----
FRONTEND_URL=http://localhost:5173
